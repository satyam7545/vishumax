# =========================================================
# Thumbnails Factory Environment Configuration
# =========================================================

# Port for production Node.js server (Default: 3000)
PORT=3000

# JSON Web Token Secret Key for Admin Authentication (REQUIRED in production)
JWT_SECRET=your_secure_random_jwt_secret_key_change_in_production_min32chars

# Database Directory (Optional, defaults to server/data/site.db)
# DB_PATH=./server/data/site.db
